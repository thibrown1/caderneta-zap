# Copie para .env e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).

# Endereço público do painel, sem https:// (ex.: caderneta-thiago.duckdns.org)
DOMINIO=

# Senha do banco Postgres: invente uma longa (ex.: openssl rand -hex 24)
DB_SENHA=

# Login do painel web
PAINEL_USUARIO=thiago
PAINEL_SENHA=

# Chave do "continuar conectado". Texto aleatório longo: openssl rand -hex 32
PAINEL_LEMBRAR_CHAVE=

# Quem pode anotar pelo WhatsApp: DDI + DDD + número, sem espaços
PESSOAS=5511999999999=Thiago,5511988888888=Larissa

# --- Meta / WhatsApp Cloud API (developers.facebook.com) ---
# Token permanente do usuário do sistema
WHATSAPP_TOKEN=
# "ID do número de telefone" na tela Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete na tela de webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app
WHATSAPP_APP_SECRET=
